# Copy this file to .env before starting the Docker stack.
RAG_MONGO_URI=mongodb://mongo:27017
RAG_MONGO_DB=rag_support
RAG_ENCRYPTION_KEY=<to_be_generated_using_command_at_line_20>
RAG_BOOTSTRAP_ADMIN_USERNAME=admin
RAG_BOOTSTRAP_ADMIN_PASSWORD=<choose_password>
RAG_SESSION_TTL_HOURS=8
RAG_COOKIE_SECURE=false
RAG_RETRIEVAL_TOP_K=4
RAG_HISTORY_TURNS=3
RAG_LLM_TIMEOUT_SECONDS=60
RAG_LOG_LEVEL=INFO
RAG_LOG_FORMAT=json
RAG_DATA_POLICY_VERSION=2026-10-08
RAG_CONVERSATION_RETENTION_DAYS=90
RAG_FEEDBACK_RETENTION_DAYS=90
RAG_AUDIT_RETENTION_DAYS=365

# PostgreSQL / pgvector & Document Ingestion
POSTGRES_PASSWORD=<choose_postgres_password>
# Note: In docker-compose, ${POSTGRES_PASSWORD} is substituted automatically.
# For local runs outside docker-compose, replace <password> with your postgres password.
RAG_PGVECTOR_DSN=postgresql://postgres:<password>@localhost:5432/rag_support
RAG_CLOUDFLARE_ACCOUNT_ID=
RAG_CLOUDFLARE_API_TOKEN=
RAG_OPENAI_API_KEY=
RAG_INGESTION_RETENTION_DAYS=90

# Generate an encryption key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
